<% unless current_account.has_enterprise_plan? %>
  <div class="alert my-4">
    <%= svg_icon('info_circle', class: 'w-6 h-6') %>
    <div>
      <p class="font-bold">
      Unlock with Enterprise Plan
      </p>
      <p>
        <%= t('display_your_company_name_and_logo_when_signing_documents') %>
        <br>
        <%= link_to t('learn_more'), plans_path, class: 'link font-medium' %>
      </p>
    </div>
  </div>
<% end %>