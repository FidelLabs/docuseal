<svg height="<%= local_assigns.fetch(:height, '37') %>" width="<%= local_assigns.fetch(:width, '37') %>" class="<%= local_assigns[:class] %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <!-- SignPaw Dog Paw Logo -->
  <!-- Main Paw Pad (center) -->
  <ellipse fill="#5B5FC7" cx="256" cy="320" rx="90" ry="100" opacity="0.95"/>
  
  <!-- Top Toes -->
  <ellipse fill="#5B5FC7" cx="200" cy="180" rx="45" ry="65" transform="rotate(-25 200 180)"/>
  <ellipse fill="#5B5FC7" cx="256" cy="140" rx="45" ry="65"/>
  <ellipse fill="#5B5FC7" cx="312" cy="180" rx="45" ry="65" transform="rotate(25 312 180)"/>
  
  <!-- Bottom Toes -->
  <ellipse fill="#7C3AED" cx="160" cy="280" rx="40" ry="60" transform="rotate(-45 160 280)"/>
  <ellipse fill="#7C3AED" cx="352" cy="280" rx="40" ry="60" transform="rotate(45 352 280)"/>
  
  <!-- Paw Pad Details (subtle) -->
  <ellipse fill="#8B5CF6" cx="256" cy="320" rx="60" ry="70" opacity="0.6"/>
  
  <!-- Optional: Small accent circles for depth -->
  <circle fill="#8B5CF6" cx="220" cy="300" r="12" opacity="0.4"/>
  <circle fill="#8B5CF6" cx="292" cy="300" r="12" opacity="0.4"/>
</svg>
