<%= content_for(:canonical_url, new_user_registration_url) %>
<div class="max-w-lg mx-auto px-2">
  <%= render 'devise/shared/select_server' if Docuseal.multitenant? %>
  <h1 class="text-4xl font-bold text-center mt-8"><%= t('sign_up') %></h1>
  <%= form_for(resource, as: resource_name, html: { class: 'space-y-6' }, data: { turbo: params[:redir].blank? }, url: user_registration_path) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= render 'devise/sessions/hidden_fields' %>
    <div class="space-y-2" dir="auto">
      <div class="form-control">
        <%= f.label :first_name, t(:first_name), class: 'label' %>
        <%= f.text_field :first_name, autofocus: true, class: 'base-input' %>
      </div>
      <div class="form-control">
        <%= f.label :last_name, t(:last_name), class: 'label' %>
        <%= f.text_field :last_name, class: 'base-input' %>
      </div>
      <div class="form-control">
        <%= f.label :email, t(:email), class: 'label' %>
        <%= f.email_field :email, autocomplete: 'email', class: 'base-input', value: params[:user]&.dig(:email) %>
      </div>
      <div class="form-control">
        <%= f.label :password, t(:password), class: 'label' %>
        <% if @minimum_password_length %>
          <span class="label-text-alt">(<%= t('minimum_password_length_characters_minimum', minimum_password_length: @minimum_password_length) %>)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'base-input' %>
      </div>
      <div class="form-control">
        <%= f.label :password_confirmation, 'Confirm Password', class: 'label' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'base-input' %>
      </div>
    </div>
    <div class="form-control">
      <%= f.button button_title(title: t(:sign_up), disabled_with: t(:sign_up)), class: 'base-button' %>
    </div>
  <% end %>
  <%= render 'devise/shared/links' %>
</div>
