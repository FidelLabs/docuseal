<% if current_account.has_enterprise_plan? %>
  <div class="mt-2 mb-1">
    <%= button_to submitter_send_sms_path(submitter_slug: submitter.slug), method: :post, class: 'btn btn-sm btn-primary w-full' do %>
      <%= submitter.sent_at? ? t('re_send_sms') : t('send_sms') %>
    <% end %>
  </div>
<% else %>
  <div class="mt-2 mb-1">
    <div class="tooltip w-full" data-tip="Unlock with Enterprise Plan">
      <%= link_to submitter.sent_at? ? t('re_send_sms') : t('send_sms'), plans_path, class: 'btn btn-sm btn-primary text-gray-400 w-full' %>
    </div>
  </div>
<% end %>
